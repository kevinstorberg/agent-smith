DATABASE_URL_DEVELOPMENT=postgresql://localhost/agent_smith
DATABASE_URL_TEST=postgresql://localhost/agent_smith_test
# DATABASE_URL_PRODUCTION — set in .env.production for remote/RDS

# RDS TLS: use the existing host certificate path in DATABASE_URL_PRODUCTION
# (sslmode=verify-full&sslrootcert=/absolute/path/rds-global-bundle.pem).

GITHUB_PERSONAL_ACCESS_TOKEN=ghp-your-token-here
SLACK_ACCESS_TOKEN=slack-access-token

# Memory backend: lancedb, pinecone, or pgvector.
MEMORY_BACKEND=lancedb
MEMORY_DECAY_RATE=0.01
MEMORY_DEFAULT_LIMIT=20

# pgvector uses DATABASE_URL_<ENV> and the memories table managed by Alembic.
# PostgreSQL must allow the vector extension before migrations run.

# Pinecone backend (set MEMORY_BACKEND=pinecone to activate)
# PINECONE_API_KEY=your-api-key
# PINECONE_INDEX=agent-smith-memories
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Embedding contract. Model and dimension must be changed together.
# MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2
# MEMORY_EMBEDDING_DIMENSION=384

# Dashboard + MCP server
DASHBOARD_PORT=7654
# Native development defaults to 7655 unless explicitly overridden.
# DASHBOARD_HOST=127.0.0.1
# DEV_FRONTEND_PORT=4321
# MEMORY_STORE_PATH=/absolute/path/to/existing/production/memory_store

# Evals
EVAL_MODEL=claude-opus-4-6
EVAL_JUDGE_MODEL=gpt-5.4
EVAL_THRESHOLD=0.8
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Graph models (opinion, improve and chat graphs)
# Each graph model role reads every MODEL_* setting from the first of these
# that defines it:
#   1. <ROLE>_MODEL_*    the role itself, e.g. OPINION_MODEL_MAX_TOKENS
#   2. <PRESET>_MODEL_*  the preset the role names in <ROLE>_MODEL_PRESET
#   3. <PARENT>_MODEL_*  the parent role's own settings: graders and readers
#                        read their graph's main role, chat participants CHAT
#   4. GRAPH_MODEL_*     the defaults below
# Roles: opinion, opinion_grader, curator, curator_grader, curator_reader, and
# chat_<name> for each CHAT_MODEL_NAMES entry. Presets are not inherited from
# the parent role: every role names its own preset (or sets MODEL_ID itself).
# Switching a role's model or adding a model only takes edits to this file.
# Settings are read at launch, so restart (./run.sh) after editing.
GRAPH_MODEL_PROVIDER=bedrock
GRAPH_MODEL_REGION=us-east-1
GRAPH_MODEL_TEMPERATURE=1.0
GRAPH_MODEL_TOP_P=0.95
# Output cap per completion; reasoning tokens count against it.
GRAPH_MODEL_MAX_TOKENS=8192
# The OpenAI SDK retries timeouts, 429s and 5xx with exponential backoff.
GRAPH_MODEL_MAX_RETRIES=6
# Seconds per attempt. Without streaming this bounds the whole response; with
# streaming it bounds the wait for each chunk, so a stalled call fails fast
# while long generations are not capped.
GRAPH_MODEL_REQUEST_TIMEOUT=300
GRAPH_MODEL_STREAMING=false
# Optional JSON object merged into every request body, for parameters without a
# dedicated setting such as a Bedrock service tier or a reasoning effort. Fields
# the runtime already sends (model, messages, max_tokens, temperature, top_p,
# stream, tools, ...) are rejected.
# GRAPH_MODEL_EXTRA_BODY='{"service_tier": "flex"}'

# Model presets: a model id, the Bedrock endpoint that serves it, its limits.
# {region} in MODEL_SERVER_URL is replaced with the role's MODEL_REGION. The two
# OpenAI-compatible Bedrock endpoints serve different model catalogs, so check
# the model card before pointing a preset at either:
#   bedrock-mantle   https://bedrock-mantle.{region}.api.aws/v1
#   bedrock-runtime  https://bedrock-runtime.{region}.amazonaws.com/openai/v1

# Kimi K3 (Moonshot AI): bedrock-runtime only, via cross-Region inference
# profiles (us. keeps traffic in the US; global. costs ~10% less). Reasoning can
# use ~75% of MAX_TOKENS. US pricing: $3.30/M input, $16.50/M output tokens.
KIMI_K3_MODEL_ID=us.moonshotai.kimi-k3
KIMI_K3_MODEL_SERVER_URL=https://bedrock-runtime.{region}.amazonaws.com/openai/v1
KIMI_K3_MODEL_MAX_TOKENS=16384
KIMI_K3_MODEL_STREAMING=true
KIMI_K3_MODEL_REQUEST_TIMEOUT=120
KIMI_K3_MODEL_MAX_RETRIES=2

# Kimi K2.5 (Moonshot AI): ~$0.60/M input, ~$3.00/M output tokens.
KIMI_K2_5_MODEL_ID=moonshotai.kimi-k2.5
KIMI_K2_5_MODEL_SERVER_URL=https://bedrock-mantle.{region}.api.aws/v1

# Qwen3 Coder 480B (Qwen): bedrock-mantle only.
QWEN3_CODER_MODEL_ID=qwen.qwen3-coder-480b-a35b-instruct
QWEN3_CODER_MODEL_SERVER_URL=https://bedrock-mantle.{region}.api.aws/v1

# Opinion graph. Rules come from the harness DB: rules assigned to the
# 'opinion' agent.
OPINION_MODEL_PRESET=KIMI_K3
OPINION_GRADER_MODEL_PRESET=KIMI_K2_5
OPINION_MODEL_SERVER_API_KEY=your-bedrock-api-key
OPINION_RUBRIC_MAX_ITERATIONS=3

# Improve graph (improvement proposals). 'curator' is the main
# pragmatic-engineer agent, 'curator_grader' the rubric grader, and
# 'curator_reader' the plan/memory digesters. Rubric rules come from the harness
# DB: rules assigned to the 'curator' agent (at least one required).
CURATOR_MODEL_PRESET=KIMI_K3
CURATOR_GRADER_MODEL_PRESET=KIMI_K2_5
CURATOR_READER_MODEL_PRESET=KIMI_K2_5
CURATOR_MODEL_SERVER_API_KEY=your-bedrock-api-key
# CURATOR_RUBRIC_MAX_ITERATIONS=3

# Chat graph AI participants. Each name is the stored message author, the
# @mention handle, and the persona name; it must not collide with
# user/claude/codex/gemini (case-insensitive). Participant <Name> is the role
# chat_<name>, so give it a model with CHAT_<NAME>_MODEL_PRESET. Replies over
# 6000 characters are rejected outright (nothing is posted).
CHAT_MODEL_SERVER_API_KEY=your-bedrock-api-key
CHAT_MODEL_NAMES=Kimi,Qwen
CHAT_KIMI_MODEL_PRESET=KIMI_K2_5
CHAT_QWEN_MODEL_PRESET=QWEN3_CODER

# DB connection pool + transient-error resilience (services/db/pool.py).
# The pool is fixed-size (minconn == maxconn == DB_POOL_MAX) so connections stay
# warm and a transient RDS blip is absorbed by bounded connect retry instead of
# failing every op. Keep DB_POOL_MAX <= the RDS instance max_connections (with
# headroom for migrations/psql). connect_timeout + TCP keepalives prevent a
# black-holed host from hanging and let the OS detect dead idle sockets.
# DB_POOL_MAX=25
# DB_CONNECT_TIMEOUT=5            # seconds, per connect attempt (TCP+TLS+auth)
# DB_CONNECT_MAX_ATTEMPTS=3       # bounded acquisition retry on transient errors
# DB_CONNECT_BACKOFF_BASE=0.1     # seconds, exponential backoff base
# DB_CONNECT_BACKOFF_MAX=1.0      # seconds, backoff cap
# DB_POOL_PRE_PING=false          # opt-in SELECT 1 on checkout (adds 1 RTT/op)

# Sync resilience (scripts/shared/agents.py::read_with_retry). Destination agent
# config files (~/.claude.json, etc.) are rewritten live by the running agent app,
# so a read can catch the file mid-write (a torn read = momentarily invalid JSON).
# Retry the read before treating it as genuine corruption; if it still won't parse,
# sync crashes loudly and never overwrites the file.
# SYNC_READ_MAX_ATTEMPTS=3         # total read attempts before declaring corruption
# SYNC_READ_BACKOFF=0.1            # seconds between attempts (live write finishes in ms)

# Device scoping — unique name per machine for device-scoped harness items
DEVICE_NAME=my-space
