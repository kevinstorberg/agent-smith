SLACK_ACCESS_TOKEN=slack-access-token
MEMORY_BACKEND=lancedb
MEMORY_DECAY_RATE=0.01
MEMORY_DEFAULT_LIMIT=20
MEMORY_LOG=false

# Pinecone backend (set MEMORY_BACKEND=pinecone to activate)
# PINECONE_API_KEY=your-api-key
# PINECONE_INDEX=agent-smith-memories
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# MCP server toggles (set to false to exclude from sync)
Amplitude_ENABLED=true
AWSDocs_ENABLED=true
AtlassianTicketsAndDocs_ENABLED=true
DataDog_ENABLED=true
Gitlab_ENABLED=true
HuggingFaceHub_ENABLED=true
LangChainDocs_ENABLED=true
OpenAIDocs_ENABLED=true
Slack_ENABLED=true
memory_ENABLED=true
