DATABASE_URL_DEVELOPMENT=postgresql://localhost/agent_smith
DATABASE_URL_TEST=postgresql://localhost/agent_smith_test
# DATABASE_URL_PRODUCTION — set in .env for remote/RDS

# RDS SSL cert — host path to mount into the container at /certs/rds-global-bundle.pem
# RDS_CERT_PATH=/Users/you/.aws/rds-global-bundle.pem

GITHUB_PERSONAL_ACCESS_TOKEN=ghp-your-token-here
SLACK_ACCESS_TOKEN=slack-access-token
MEMORY_BACKEND=lancedb
MEMORY_DECAY_RATE=0.01
MEMORY_DEFAULT_LIMIT=20

# Pinecone backend (set MEMORY_BACKEND=pinecone to activate)
# PINECONE_API_KEY=your-api-key
# PINECONE_INDEX=agent-smith-memories
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Embedding model (default: all-MiniLM-L6-v2, 384 dims)
# MEMORY_EMBEDDING_MODEL=all-mpnet-base-v2

# Dashboard + MCP server
DASHBOARD_PORT=7654

# Evals
EVAL_MODEL=claude-opus-4-6
EVAL_JUDGE_MODEL=gpt-5.4
EVAL_THRESHOLD=0.8
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# Opinion graph — Kimi K2.5 via AWS Bedrock (pay-per-token: ~$0.60/M input, ~$3.00/M output)
OPINION_MODEL_PROVIDER=bedrock
OPINION_MODEL_ID=moonshotai.kimi-k2.5
OPINION_MODEL_REGION=us-east-1
# OPINION_MODEL_SERVER_URL=https://bedrock-mantle.us-east-1.api.aws/v1  # derived from region if unset
OPINION_MODEL_SERVER_API_KEY=your-bedrock-api-key
# OPINION_MODEL_MAX_TOKENS=8192  # output cap per completion (default 8192)
OPINION_RUBRIC_MAX_ITERATIONS=3
# Rules come from the harness DB: rules assigned to the 'opinion' agent.

# Improve graph (improvement proposals) — same Bedrock setup as the opinion graph.
# Roles: 'curator' = main pragmatic-engineer agent (use a powerful model),
# 'curator_grader' = rubric grader, 'curator_reader' = plan/memory curators;
# both fall back to CURATOR_* then GRAPH_MODEL_*. Rubric rules come from the
# harness DB: rules assigned to the 'curator' agent (at least one required).
CURATOR_MODEL_PROVIDER=bedrock
CURATOR_MODEL_ID=moonshotai.kimi-k2.5
CURATOR_MODEL_REGION=us-east-1
CURATOR_MODEL_SERVER_API_KEY=your-bedrock-api-key
# CURATOR_MODEL_MAX_TOKENS=8192  # output cap per completion (default 8192)
# CURATOR_RUBRIC_MAX_ITERATIONS=3

# Retry tuning for all graph model calls (defaults shown); overridable per-role
# (e.g. CURATOR_MODEL_MAX_RETRIES) or globally via GRAPH_MODEL_*. The OpenAI SDK
# applies exponential backoff on 429/5xx so transient Bedrock 503s self-heal.
# GRAPH_MODEL_MAX_RETRIES=6
# GRAPH_MODEL_REQUEST_TIMEOUT=300  # seconds per call; must exceed a full generation

# DB connection pool + transient-error resilience (services/db/pool.py).
# The pool is fixed-size (minconn == maxconn == DB_POOL_MAX) so connections stay
# warm and a transient RDS blip is absorbed by bounded connect retry instead of
# failing every op. Keep DB_POOL_MAX <= the RDS instance max_connections (with
# headroom for migrations/psql). connect_timeout + TCP keepalives prevent a
# black-holed host from hanging and let the OS detect dead idle sockets.
# DB_POOL_MAX=25
# DB_CONNECT_TIMEOUT=5            # seconds, per connect attempt (TCP+TLS+auth)
# DB_CONNECT_MAX_ATTEMPTS=3       # bounded acquisition retry on transient errors
# DB_CONNECT_BACKOFF_BASE=0.1     # seconds, exponential backoff base
# DB_CONNECT_BACKOFF_MAX=1.0      # seconds, backoff cap
# DB_POOL_PRE_PING=false          # opt-in SELECT 1 on checkout (adds 1 RTT/op)

# Sync resilience (scripts/shared/agents.py::read_with_retry). Destination agent
# config files (~/.claude.json, etc.) are rewritten live by the running agent app,
# so a read can catch the file mid-write (a torn read = momentarily invalid JSON).
# Retry the read before treating it as genuine corruption; if it still won't parse,
# sync crashes loudly and never overwrites the file.
# SYNC_READ_MAX_ATTEMPTS=3         # total read attempts before declaring corruption
# SYNC_READ_BACKOFF=0.1            # seconds between attempts (live write finishes in ms)

# Device scoping — unique name per machine for device-scoped harness items
DEVICE_NAME=my-space
