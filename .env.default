SLACK_ACCESS_TOKEN=slack-access-token
MEMORY_BACKEND=lancedb
MEMORY_DECAY_RATE=0.01
MEMORY_DEFAULT_LIMIT=20
MEMORY_LOG=false

# Pinecone backend (set MEMORY_BACKEND=pinecone to activate)
# PINECONE_API_KEY=your-api-key
# PINECONE_INDEX=agent-smith-memories
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# DocumentDB backend (set MEMORY_BACKEND=documentdb to activate)
# DOCUMENTDB_URI=mongodb://user:pass@host:27017/?tls=true&retryWrites=false
# DOCUMENTDB_DATABASE=agent_smith
# DOCUMENTDB_COLLECTION=memories
# DOCUMENTDB_TLS_CA_FILE=/path/to/global-bundle.pem

# Embedding model (default: all-MiniLM-L6-v2, 384 dims)
# Upgrade to all-mpnet-base-v2 for 768 dims with better quality
# MEMORY_EMBEDDING_MODEL=all-mpnet-base-v2

# Database — default is local; override in .env for remote RDS:
# DATABASE_URL=postgresql://user:pass@host.region.rds.amazonaws.com:5432/agent_smith?sslmode=verify-full&sslrootcert=~/.aws/rds-global-bundle.pem
# DATABASE_URL=postgresql://localhost/agent_smith

# Dashboard
DASHBOARD_PORT=7654

# Evals
EVAL_MODEL=claude-opus-4-6
EVAL_JUDGE_MODEL=gpt-5.4
EVAL_THRESHOLD=0.8
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# MCP server toggles (set to false to exclude from sync)
Amplitude_ENABLED=true
AWSDocs_ENABLED=true
AtlassianTicketsAndDocs_ENABLED=true
DataDog_ENABLED=true
Gitlab_ENABLED=true
HuggingFaceHub_ENABLED=true
LangChainDocs_ENABLED=true
OpenAIDocs_ENABLED=true
Slack_ENABLED=true
memory_ENABLED=true
