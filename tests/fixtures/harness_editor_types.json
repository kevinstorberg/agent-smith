{
  "descriptors": {
    "common": [
      {
        "key": "name",
        "label": "Name",
        "kind": "text",
        "placeholder": "review_changes",
        "required": true,
        "max_length": 40,
        "default": ""
      },
      {
        "key": "project",
        "label": "Project",
        "kind": "text",
        "placeholder": "agent-smith (leave empty to share)",
        "required": false,
        "default": ""
      },
      {
        "key": "sort_key",
        "label": "Sort order",
        "kind": "number",
        "placeholder": "5",
        "required": false,
        "default": 0,
        "minimum": 0
      },
      {
        "key": "agents",
        "label": "Available to agents",
        "kind": "multiselect",
        "placeholder": "Choose the agents that can use this item",
        "required": true,
        "choices": [
          "claude",
          "codex",
          "gemini",
          "opinion",
          "curator"
        ],
        "default": [
          "claude",
          "codex",
          "gemini"
        ]
      },
      {
        "key": "subagents",
        "label": "Subagent audience",
        "kind": "strings",
        "placeholder": "reviewer (or * for every subagent)",
        "required": false,
        "default": []
      },
      {
        "key": "enabled",
        "label": "Enabled",
        "kind": "boolean",
        "placeholder": "Enable this item",
        "required": false,
        "default": true
      },
      {
        "key": "device",
        "label": "Initial device",
        "kind": "text",
        "placeholder": "* or my-macbook",
        "required": false,
        "default": "*",
        "create_only": true
      },
      {
        "key": "repo",
        "label": "Initial repository",
        "kind": "text",
        "placeholder": "* or /Users/me/projects/agent-smith",
        "required": false,
        "default": "*",
        "create_only": true
      }
    ],
    "types": {
      "skill": {
        "label": "Skill",
        "initial_extensions": {
          "frontmatter": {},
          "metadata": {}
        },
        "fields": [
          {
            "key": "description",
            "label": "Description / when to use",
            "kind": "text",
            "placeholder": "Use when reviewing changes for security and correctness.",
            "required": true,
            "default": ""
          },
          {
            "key": "instructions",
            "label": "Instructions",
            "kind": "markdown",
            "placeholder": "Read the changed files, explain the findings, and cite concrete evidence.",
            "required": true,
            "default": ""
          },
          {
            "key": "files",
            "label": "Supporting files",
            "kind": "rows",
            "placeholder": "references/review-checklist.md",
            "required": false,
            "default": [],
            "fields": [
              {
                "key": "path",
                "label": "File path",
                "kind": "text",
                "placeholder": "references/review-checklist.md",
                "required": true
              },
              {
                "key": "content",
                "label": "File content",
                "kind": "markdown",
                "placeholder": "# Review checklist\n\nCheck inputs, errors, and boundary conditions.",
                "required": false
              }
            ]
          }
        ]
      },
      "rule": {
        "label": "Rule",
        "initial_extensions": {
          "metadata": {}
        },
        "common_fields": [
          {
            "key": "clone_as_skill",
            "label": "Publish as a skill",
            "kind": "boolean",
            "placeholder": "Also publish these instructions as a skill artifact",
            "required": false,
            "default": false
          }
        ],
        "fields": [
          {
            "key": "instructions",
            "label": "Instructions",
            "kind": "markdown",
            "placeholder": "Explain the complete task, constraints, context and expected result.",
            "required": true,
            "default": ""
          },
          {
            "key": "clone_description",
            "label": "Skill description / when to use",
            "kind": "text",
            "placeholder": "Use when reviewing application changes.",
            "required": true,
            "default": "",
            "when": {
              "clone_as_skill": "true"
            }
          }
        ]
      },
      "tool": {
        "label": "Tool",
        "initial_extensions": {
          "metadata": {},
          "oauth": {}
        },
        "fields": [
          {
            "key": "transport",
            "label": "Connection type",
            "kind": "select",
            "placeholder": "HTTP or a local command",
            "required": true,
            "choices": [
              "http",
              "stdio"
            ],
            "default": "http"
          },
          {
            "key": "description",
            "label": "Description",
            "kind": "text",
            "placeholder": "Local repository maintenance tools",
            "required": false,
            "default": ""
          },
          {
            "key": "url",
            "label": "Server URL",
            "kind": "text",
            "placeholder": "https://example.com/mcp or ${MCP_BASE}/mcp",
            "required": true,
            "default": "",
            "when": {
              "transport": "http"
            }
          },
          {
            "key": "command",
            "label": "Executable",
            "kind": "text",
            "placeholder": "${AGENT_SMITH_ROOT}/.venv/bin/python",
            "required": true,
            "default": "",
            "when": {
              "transport": "stdio"
            }
          },
          {
            "key": "args",
            "label": "Arguments",
            "kind": "strings",
            "placeholder": "--config (enter one argument per row)",
            "required": false,
            "default": [],
            "when": {
              "transport": "stdio"
            }
          },
          {
            "key": "env",
            "label": "Environment variables",
            "kind": "pairs",
            "placeholder": "API_TOKEN",
            "required": false,
            "default": [],
            "fields": [
              {
                "key": "key",
                "label": "Variable",
                "kind": "text",
                "placeholder": "API_TOKEN",
                "required": true,
                "default": ""
              },
              {
                "key": "value",
                "label": "Value",
                "kind": "text",
                "placeholder": "${API_TOKEN}",
                "required": false,
                "default": ""
              }
            ],
            "when": {
              "transport": "stdio"
            }
          },
          {
            "key": "headers",
            "label": "HTTP headers",
            "kind": "pairs",
            "placeholder": "Authorization",
            "required": false,
            "default": [],
            "fields": [
              {
                "key": "key",
                "label": "Header",
                "kind": "text",
                "placeholder": "Authorization",
                "required": true,
                "default": ""
              },
              {
                "key": "value",
                "label": "Value",
                "kind": "text",
                "placeholder": "Bearer ${API_TOKEN}",
                "required": false,
                "default": ""
              }
            ],
            "when": {
              "transport": "http"
            }
          },
          {
            "key": "oauth_client_id",
            "label": "OAuth client ID",
            "kind": "text",
            "placeholder": "my-client-id",
            "required": false,
            "default": "",
            "when": {
              "transport": "http"
            }
          },
          {
            "key": "notes",
            "label": "Notes",
            "kind": "markdown",
            "placeholder": "Optional notes about this integration.",
            "required": false,
            "default": ""
          }
        ]
      },
      "hook": {
        "label": "Hook",
        "initial_extensions": {
          "metadata": {}
        },
        "fields": [
          {
            "key": "event",
            "label": "When to run",
            "kind": "select",
            "placeholder": "pre_tool_use",
            "required": true,
            "choices": [
              "instructions_loaded",
              "notification",
              "permission_request",
              "post_tool_use",
              "post_tool_use_failure",
              "pre_tool_use",
              "session_end",
              "session_start",
              "stop",
              "stop_failure",
              "subagent_start",
              "subagent_stop",
              "user_prompt_submit"
            ],
            "default": "pre_tool_use"
          },
          {
            "key": "matcher",
            "label": "Tool matcher",
            "kind": "text",
            "placeholder": "Bash|Edit|Write",
            "required": false,
            "default": ""
          },
          {
            "key": "default_model",
            "label": "Default model for AI handlers",
            "kind": "text",
            "placeholder": "haiku (optional)",
            "required": false,
            "default": ""
          },
          {
            "key": "handlers",
            "label": "Handlers",
            "kind": "rows",
            "placeholder": "Add a command, prompt, or agent handler",
            "required": false,
            "default": [],
            "fields": [
              {
                "key": "type",
                "label": "Handler type",
                "kind": "select",
                "placeholder": "command",
                "required": true,
                "choices": [
                  "command",
                  "prompt",
                  "agent"
                ],
                "default": "command"
              },
              {
                "key": "command",
                "label": "Command",
                "kind": "text",
                "placeholder": "python /absolute/path/check.py",
                "required": true,
                "default": "",
                "when": {
                  "type": "command"
                }
              },
              {
                "key": "prompt",
                "label": "Prompt",
                "kind": "markdown",
                "placeholder": "Review the complete tool input and explain whether it should proceed.",
                "required": true,
                "default": "",
                "when": {
                  "type": [
                    "prompt",
                    "agent"
                  ]
                }
              },
              {
                "key": "model",
                "label": "Handler model override",
                "kind": "text",
                "placeholder": "haiku (uses default when empty)",
                "required": false,
                "default": "",
                "when": {
                  "type": [
                    "prompt",
                    "agent"
                  ]
                }
              },
              {
                "key": "timeout",
                "label": "Timeout in seconds",
                "kind": "number",
                "placeholder": "30",
                "required": false,
                "default": null,
                "minimum": 0.001
              },
              {
                "key": "async",
                "label": "Run command asynchronously",
                "kind": "boolean",
                "placeholder": "Allow this command to continue without blocking",
                "required": false,
                "default": false,
                "when": {
                  "type": "command"
                }
              },
              {
                "key": "settings",
                "label": "Additional handler settings",
                "kind": "json",
                "placeholder": "Optional handler-specific settings",
                "required": false,
                "default": {}
              }
            ]
          },
          {
            "key": "permissions",
            "label": "Allowed tool permissions",
            "kind": "strings",
            "placeholder": "mcp__memory__memory_search",
            "required": false,
            "default": []
          },
          {
            "key": "notes",
            "label": "Notes",
            "kind": "markdown",
            "placeholder": "Optional notes about this integration.",
            "required": false,
            "default": ""
          }
        ]
      },
      "agent": {
